# ------------------------------------------------------------------------------
# NetBox
# ------------------------------------------------------------------------------

NETBOX_PORT=8000

NETBOX_ALLOWED_HOSTS=localhost 127.0.0.1
NETBOX_TIME_ZONE=Asia/Tokyo

NETBOX_CENSUS_REPORTING_ENABLED=false
NETBOX_COPILOT_ENABLED=false

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------

PSQL_HOST=
PSQL_PORT=5432
PSQL_DATABASE=netbox
PSQL_USERNAME=netbox

PSQL_SSL_MODE=require
PSQL_CONN_MAX_AGE=300

# ------------------------------------------------------------------------------
# Redis / Valkey - Tasks
# ------------------------------------------------------------------------------

REDIS_TASKS_HOST=
REDIS_TASKS_PORT=6379
REDIS_TASKS_USERNAME=

REDIS_TASKS_DATABASE=0
REDIS_TASKS_SSL=true
REDIS_TASKS_INSECURE_SKIP_TLS_VERIFY=false

# ------------------------------------------------------------------------------
# Redis / Valkey - Cache
# ------------------------------------------------------------------------------

REDIS_CACHE_HOST=
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=

REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=true
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false

# ------------------------------------------------------------------------------
# S3-compatible object storage
# ------------------------------------------------------------------------------

S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=

S3_MEDIA_PREFIX=media
